# Server-side secrets for the video-storage Edge Function. NEVER prefix these with VITE_.
# Set them on the project with:  npx supabase secrets set --env-file supabase/functions/.env
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_REGION=<region, e.g. us-west-004>
B2_BUCKET=<private bucket name>
B2_KEY_ID=<application key id restricted to that bucket>
B2_APPLICATION_KEY=<application key>
