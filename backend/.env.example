# VisionGuard Local AI Backend Configuration
VISIONGUARD_HOST=127.0.0.1
VISIONGUARD_PORT=8000

# Path to YOLO11n ONNX model (defaults to apps/web/public/models/yolo11n.onnx)
# VISIONGUARD_MODEL_PATH=../apps/web/public/models/yolo11n.onnx

# Execution provider: auto-detected if omitted (e.g. DmlExecutionProvider, CPUExecutionProvider)
# VISIONGUARD_EXECUTION_PROVIDER=CPUExecutionProvider

# Upload and artifact limits
VISIONGUARD_MAX_UPLOAD_BYTES=1073741824
VISIONGUARD_MAX_CONCURRENT_JOBS=1
VISIONGUARD_CONF_THRESHOLD=0.20
VISIONGUARD_IOU_THRESHOLD=0.45
VISIONGUARD_RETENTION_HOURS=24
