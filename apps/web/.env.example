# Copy this file to apps/web/.env.local (NOT the repository root).
# It is read by Vite when you run: npm run dev
#
# Supabase remains the authentication/metadata service. The browser needs
# its PUBLIC project URL and publishable key to authenticate B2 upload signing.
# Find both in Supabase Dashboard > Project Settings > API Keys / Connect.
#
# DO NOT PUT B2_APPLICATION_KEY, service_role, or sb_secret_* in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY accepts the modern sb_publishable_* public browser key.
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# For Cloudflare Workers/Pages, configure a PUBLIC HTTPS model URL.
# Example, if you have uploaded a licensed YOLO11s model to Hugging Face:
# https://huggingface.co/SyedNazeer07/visionguard-yolo11s/resolve/main/yolo11s.onnx
# The external host must allow browser HEAD/GET and CORS from the deployment.
# Separately, the Cloudflare production build uses version-matched jsDelivr
# for ONNX Runtime's >25 MiB WASM binary without any R2 subscription.
# Model weights are public; never use a private B2 video link as model URL.
VITE_YOLO_MODEL_URL=

# Video bytes are stored in Backblaze B2; never in Supabase Storage.
VITE_VIDEO_STORAGE_PROVIDER=b2

# No local Python analysis URL is needed: the ONNX model runs in the browser.
