# Local staging environment for the newly-created VisionGuard Supabase project.
# Copy to the REPOSITORY ROOT .env (never commit the filled-in .env).
#
# Supabase project: visionguard-staging (Mumbai / ap-south-1)
# The public/publishable browser key can be found in:
# https://supabase.com/dashboard/project/wpkwxlhwjkgtvyersust/settings/api-keys
# Do not paste service_role or secret keys into any VITE_ variable.

VITE_SUPABASE_URL=https://wpkwxlhwjkgtvyersust.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_OR_LEGACY_ANON_KEY

# B2 credentials/functions are not configured for this new staging project.
# Use the private 'videos' Supabase Storage bucket with signed playback URLs.
VITE_VIDEO_STORAGE_PROVIDER=supabase

# Optional: keep the local analysis backend on loopback.
VISIONGUARD_HOST=127.0.0.1
VISIONGUARD_PORT=8000

# Remote video_url is disabled until you explicitly allowlist your staging
# Storage hostname. For a local browser-only analysis, keep it empty.
VISIONGUARD_ALLOWED_VIDEO_HOSTS=
