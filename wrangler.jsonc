{
  "name": "visionguard",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/model/*"
    ]
  },
  "main": "./worker/index.mjs"
}
